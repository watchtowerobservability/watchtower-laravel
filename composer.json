{
  "name": "watchtowerobservability/laravel",
  "description": "Watchtower for Laravel: exception reporting, queue and query spans, log channel",
  "license": "Apache-2.0",
  "type": "library",
  "require": {
    "php": ">=8.1",
    "watchtowerobservability/sdk": "*",
    "open-telemetry/api": "^1.0",
    "illuminate/support": "^10.0||^11.0||^12.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0||^9.0||^10.0",
    "phpunit/phpunit": "^10.5||^11.0"
  },
  "repositories": [
    { "type": "vcs", "url": "https://github.com/watchtowerobservability/watchtower-php" }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": { "psr-4": { "Watchtower\\Laravel\\": "src/" } },
  "autoload-dev": { "psr-4": { "Watchtower\\Laravel\\Tests\\": "tests/" } },
  "extra": { "laravel": { "providers": ["Watchtower\\Laravel\\WatchtowerServiceProvider"] } }
}
